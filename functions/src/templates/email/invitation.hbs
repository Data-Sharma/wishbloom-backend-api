<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
  <h2>You're invited to {{eventTitle}}!</h2>
  <p>Hi {{guestName}},</p>
  <p>{{hostName}} has invited you to celebrate.</p>
  <p><strong>Date:</strong> {{eventDate}}</p>
  <p><strong>Location:</strong> {{eventLocation}}</p>
  <a href="{{rsvpLink}}" style="display:inline-block;padding:12px 24px;background:#32b8c6;color:#fff;text-decoration:none;border-radius:6px;">RSVP Now</a>
  <p>We hope to see you there!</p>
</div>
<div style="font-family: Arial, sans-serif;">
  <h2>{{eventTitle}}</h2>
  <p>Hi {{guestName}},</p>
  <p>{{hostName}} has invited you to their event on {{eventDate}} at {{eventLocation}}.</p>
  <p>Please confirm your attendance:</p>
  <a href="{{rsvpLink}}" style="padding: 12px 24px; background:#32b8c6; color:#fff; text-decoration:none;">RSVP Now</a>
</div>

